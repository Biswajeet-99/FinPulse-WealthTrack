import os
from typing import List, Dict, Tuple

import mysql.connector
from dotenv import load_dotenv
from mysql.connector import Error


load_dotenv()


class DatabaseManager:
    """Small database wrapper with a safe demo fallback."""

    def __init__(self, use_demo_data: bool | None = None):
        self.host = os.getenv("DB_HOST", "localhost")
        self.user = os.getenv("DB_USER", "root")
        self.password = os.getenv("DB_PASSWORD", "")
        self.database = os.getenv("DB_NAME", "finpulse")
        self.use_demo_data = (
            use_demo_data
            if use_demo_data is not None
            else not all([self.host, self.user, self.database])
        )

    def get_connection(self):
        """Establishes and returns a database connection."""
        if self.use_demo_data:
            return None

        try:
            return mysql.connector.connect(
                host=self.host,
                user=self.user,
                password=self.password,
                database=self.database,
                autocommit=True,
            )
        except Error as exc:
            print(f"Database connection failed: {exc}")
            return None

    def fetch_user_expenses(self, user_id: int) -> Tuple[list, list]:
        """Retrieves aggregated expenses for a user."""
        if self.use_demo_data:
            demo_data = {
                "Housing": 8200.0,
                "Food": 2800.0,
                "Transport": 1800.0,
                "Utilities": 1200.0,
                "Entertainment": 900.0,
            }
            categories = list(demo_data.keys())
            amounts = list(demo_data.values())
            return categories, amounts

        conn = self.get_connection()
        if not conn:
            return [], []

        cursor = None
        try:
            cursor = conn.cursor()
            query = """
                SELECT category, SUM(amount)
                FROM transactions
                WHERE user_id = %s AND type = 'Expense'
                GROUP BY category
            """
            cursor.execute(query, (user_id,))
            data = cursor.fetchall()
            categories = [row[0] for row in data]
            amounts = [float(row[1]) for row in data]
            return categories, amounts
        except Error as exc:
            print(f"Failed to fetch user expenses: {exc}")
            return [], []
        finally:
            if cursor:
                cursor.close()
            if conn.is_connected():
                conn.close()

    def fetch_recent_transactions(self, user_id: int, limit: int = 5) -> List[Dict[str, object]]:
        """Fetches recent transactions for the dashboard feed."""
        if self.use_demo_data:
            return [
                {"date": "2026-10-28", "category": "Housing", "type": "Expense", "amount": 3200.0},
                {"date": "2026-10-27", "category": "Food", "type": "Expense", "amount": 1550.0},
                {"date": "2026-10-26", "category": "Salary", "type": "Income", "amount": 45000.0},
                {"date": "2026-10-22", "category": "Transport", "type": "Expense", "amount": 820.0},
                {"date": "2026-10-20", "category": "Utilities", "type": "Expense", "amount": 980.0},
            ][:limit]

        conn = self.get_connection()
        if not conn:
            return []

        cursor = None
        try:
            cursor = conn.cursor(dictionary=True)
            query = """
                SELECT category, amount, type, transaction_date AS date
                FROM transactions
                WHERE user_id = %s
                ORDER BY transaction_date DESC
                LIMIT %s
            """
            cursor.execute(query, (user_id, limit))
            return cursor.fetchall()
        except Error as exc:
            print(f"Failed to fetch recent transactions: {exc}")
            return []
        finally:
            if cursor:
                cursor.close()
            if conn.is_connected():
                conn.close()

    def fetch_dashboard_summary(self, user_id: int) -> Dict[str, float]:
        """Returns key financial summaries for the main dashboard."""
        categories, amounts = self.fetch_user_expenses(user_id)
        total_expenses = sum(amounts)
        income = 45000.0 if self.use_demo_data else 0.0
        return {
            "income": income,
            "expenses": total_expenses,
            "balance": income - total_expenses,
        }

    def __repr__(self) -> str:
        return f"DatabaseManager(host={self.host}, database={self.database}, demo_mode={self.use_demo_data})"

