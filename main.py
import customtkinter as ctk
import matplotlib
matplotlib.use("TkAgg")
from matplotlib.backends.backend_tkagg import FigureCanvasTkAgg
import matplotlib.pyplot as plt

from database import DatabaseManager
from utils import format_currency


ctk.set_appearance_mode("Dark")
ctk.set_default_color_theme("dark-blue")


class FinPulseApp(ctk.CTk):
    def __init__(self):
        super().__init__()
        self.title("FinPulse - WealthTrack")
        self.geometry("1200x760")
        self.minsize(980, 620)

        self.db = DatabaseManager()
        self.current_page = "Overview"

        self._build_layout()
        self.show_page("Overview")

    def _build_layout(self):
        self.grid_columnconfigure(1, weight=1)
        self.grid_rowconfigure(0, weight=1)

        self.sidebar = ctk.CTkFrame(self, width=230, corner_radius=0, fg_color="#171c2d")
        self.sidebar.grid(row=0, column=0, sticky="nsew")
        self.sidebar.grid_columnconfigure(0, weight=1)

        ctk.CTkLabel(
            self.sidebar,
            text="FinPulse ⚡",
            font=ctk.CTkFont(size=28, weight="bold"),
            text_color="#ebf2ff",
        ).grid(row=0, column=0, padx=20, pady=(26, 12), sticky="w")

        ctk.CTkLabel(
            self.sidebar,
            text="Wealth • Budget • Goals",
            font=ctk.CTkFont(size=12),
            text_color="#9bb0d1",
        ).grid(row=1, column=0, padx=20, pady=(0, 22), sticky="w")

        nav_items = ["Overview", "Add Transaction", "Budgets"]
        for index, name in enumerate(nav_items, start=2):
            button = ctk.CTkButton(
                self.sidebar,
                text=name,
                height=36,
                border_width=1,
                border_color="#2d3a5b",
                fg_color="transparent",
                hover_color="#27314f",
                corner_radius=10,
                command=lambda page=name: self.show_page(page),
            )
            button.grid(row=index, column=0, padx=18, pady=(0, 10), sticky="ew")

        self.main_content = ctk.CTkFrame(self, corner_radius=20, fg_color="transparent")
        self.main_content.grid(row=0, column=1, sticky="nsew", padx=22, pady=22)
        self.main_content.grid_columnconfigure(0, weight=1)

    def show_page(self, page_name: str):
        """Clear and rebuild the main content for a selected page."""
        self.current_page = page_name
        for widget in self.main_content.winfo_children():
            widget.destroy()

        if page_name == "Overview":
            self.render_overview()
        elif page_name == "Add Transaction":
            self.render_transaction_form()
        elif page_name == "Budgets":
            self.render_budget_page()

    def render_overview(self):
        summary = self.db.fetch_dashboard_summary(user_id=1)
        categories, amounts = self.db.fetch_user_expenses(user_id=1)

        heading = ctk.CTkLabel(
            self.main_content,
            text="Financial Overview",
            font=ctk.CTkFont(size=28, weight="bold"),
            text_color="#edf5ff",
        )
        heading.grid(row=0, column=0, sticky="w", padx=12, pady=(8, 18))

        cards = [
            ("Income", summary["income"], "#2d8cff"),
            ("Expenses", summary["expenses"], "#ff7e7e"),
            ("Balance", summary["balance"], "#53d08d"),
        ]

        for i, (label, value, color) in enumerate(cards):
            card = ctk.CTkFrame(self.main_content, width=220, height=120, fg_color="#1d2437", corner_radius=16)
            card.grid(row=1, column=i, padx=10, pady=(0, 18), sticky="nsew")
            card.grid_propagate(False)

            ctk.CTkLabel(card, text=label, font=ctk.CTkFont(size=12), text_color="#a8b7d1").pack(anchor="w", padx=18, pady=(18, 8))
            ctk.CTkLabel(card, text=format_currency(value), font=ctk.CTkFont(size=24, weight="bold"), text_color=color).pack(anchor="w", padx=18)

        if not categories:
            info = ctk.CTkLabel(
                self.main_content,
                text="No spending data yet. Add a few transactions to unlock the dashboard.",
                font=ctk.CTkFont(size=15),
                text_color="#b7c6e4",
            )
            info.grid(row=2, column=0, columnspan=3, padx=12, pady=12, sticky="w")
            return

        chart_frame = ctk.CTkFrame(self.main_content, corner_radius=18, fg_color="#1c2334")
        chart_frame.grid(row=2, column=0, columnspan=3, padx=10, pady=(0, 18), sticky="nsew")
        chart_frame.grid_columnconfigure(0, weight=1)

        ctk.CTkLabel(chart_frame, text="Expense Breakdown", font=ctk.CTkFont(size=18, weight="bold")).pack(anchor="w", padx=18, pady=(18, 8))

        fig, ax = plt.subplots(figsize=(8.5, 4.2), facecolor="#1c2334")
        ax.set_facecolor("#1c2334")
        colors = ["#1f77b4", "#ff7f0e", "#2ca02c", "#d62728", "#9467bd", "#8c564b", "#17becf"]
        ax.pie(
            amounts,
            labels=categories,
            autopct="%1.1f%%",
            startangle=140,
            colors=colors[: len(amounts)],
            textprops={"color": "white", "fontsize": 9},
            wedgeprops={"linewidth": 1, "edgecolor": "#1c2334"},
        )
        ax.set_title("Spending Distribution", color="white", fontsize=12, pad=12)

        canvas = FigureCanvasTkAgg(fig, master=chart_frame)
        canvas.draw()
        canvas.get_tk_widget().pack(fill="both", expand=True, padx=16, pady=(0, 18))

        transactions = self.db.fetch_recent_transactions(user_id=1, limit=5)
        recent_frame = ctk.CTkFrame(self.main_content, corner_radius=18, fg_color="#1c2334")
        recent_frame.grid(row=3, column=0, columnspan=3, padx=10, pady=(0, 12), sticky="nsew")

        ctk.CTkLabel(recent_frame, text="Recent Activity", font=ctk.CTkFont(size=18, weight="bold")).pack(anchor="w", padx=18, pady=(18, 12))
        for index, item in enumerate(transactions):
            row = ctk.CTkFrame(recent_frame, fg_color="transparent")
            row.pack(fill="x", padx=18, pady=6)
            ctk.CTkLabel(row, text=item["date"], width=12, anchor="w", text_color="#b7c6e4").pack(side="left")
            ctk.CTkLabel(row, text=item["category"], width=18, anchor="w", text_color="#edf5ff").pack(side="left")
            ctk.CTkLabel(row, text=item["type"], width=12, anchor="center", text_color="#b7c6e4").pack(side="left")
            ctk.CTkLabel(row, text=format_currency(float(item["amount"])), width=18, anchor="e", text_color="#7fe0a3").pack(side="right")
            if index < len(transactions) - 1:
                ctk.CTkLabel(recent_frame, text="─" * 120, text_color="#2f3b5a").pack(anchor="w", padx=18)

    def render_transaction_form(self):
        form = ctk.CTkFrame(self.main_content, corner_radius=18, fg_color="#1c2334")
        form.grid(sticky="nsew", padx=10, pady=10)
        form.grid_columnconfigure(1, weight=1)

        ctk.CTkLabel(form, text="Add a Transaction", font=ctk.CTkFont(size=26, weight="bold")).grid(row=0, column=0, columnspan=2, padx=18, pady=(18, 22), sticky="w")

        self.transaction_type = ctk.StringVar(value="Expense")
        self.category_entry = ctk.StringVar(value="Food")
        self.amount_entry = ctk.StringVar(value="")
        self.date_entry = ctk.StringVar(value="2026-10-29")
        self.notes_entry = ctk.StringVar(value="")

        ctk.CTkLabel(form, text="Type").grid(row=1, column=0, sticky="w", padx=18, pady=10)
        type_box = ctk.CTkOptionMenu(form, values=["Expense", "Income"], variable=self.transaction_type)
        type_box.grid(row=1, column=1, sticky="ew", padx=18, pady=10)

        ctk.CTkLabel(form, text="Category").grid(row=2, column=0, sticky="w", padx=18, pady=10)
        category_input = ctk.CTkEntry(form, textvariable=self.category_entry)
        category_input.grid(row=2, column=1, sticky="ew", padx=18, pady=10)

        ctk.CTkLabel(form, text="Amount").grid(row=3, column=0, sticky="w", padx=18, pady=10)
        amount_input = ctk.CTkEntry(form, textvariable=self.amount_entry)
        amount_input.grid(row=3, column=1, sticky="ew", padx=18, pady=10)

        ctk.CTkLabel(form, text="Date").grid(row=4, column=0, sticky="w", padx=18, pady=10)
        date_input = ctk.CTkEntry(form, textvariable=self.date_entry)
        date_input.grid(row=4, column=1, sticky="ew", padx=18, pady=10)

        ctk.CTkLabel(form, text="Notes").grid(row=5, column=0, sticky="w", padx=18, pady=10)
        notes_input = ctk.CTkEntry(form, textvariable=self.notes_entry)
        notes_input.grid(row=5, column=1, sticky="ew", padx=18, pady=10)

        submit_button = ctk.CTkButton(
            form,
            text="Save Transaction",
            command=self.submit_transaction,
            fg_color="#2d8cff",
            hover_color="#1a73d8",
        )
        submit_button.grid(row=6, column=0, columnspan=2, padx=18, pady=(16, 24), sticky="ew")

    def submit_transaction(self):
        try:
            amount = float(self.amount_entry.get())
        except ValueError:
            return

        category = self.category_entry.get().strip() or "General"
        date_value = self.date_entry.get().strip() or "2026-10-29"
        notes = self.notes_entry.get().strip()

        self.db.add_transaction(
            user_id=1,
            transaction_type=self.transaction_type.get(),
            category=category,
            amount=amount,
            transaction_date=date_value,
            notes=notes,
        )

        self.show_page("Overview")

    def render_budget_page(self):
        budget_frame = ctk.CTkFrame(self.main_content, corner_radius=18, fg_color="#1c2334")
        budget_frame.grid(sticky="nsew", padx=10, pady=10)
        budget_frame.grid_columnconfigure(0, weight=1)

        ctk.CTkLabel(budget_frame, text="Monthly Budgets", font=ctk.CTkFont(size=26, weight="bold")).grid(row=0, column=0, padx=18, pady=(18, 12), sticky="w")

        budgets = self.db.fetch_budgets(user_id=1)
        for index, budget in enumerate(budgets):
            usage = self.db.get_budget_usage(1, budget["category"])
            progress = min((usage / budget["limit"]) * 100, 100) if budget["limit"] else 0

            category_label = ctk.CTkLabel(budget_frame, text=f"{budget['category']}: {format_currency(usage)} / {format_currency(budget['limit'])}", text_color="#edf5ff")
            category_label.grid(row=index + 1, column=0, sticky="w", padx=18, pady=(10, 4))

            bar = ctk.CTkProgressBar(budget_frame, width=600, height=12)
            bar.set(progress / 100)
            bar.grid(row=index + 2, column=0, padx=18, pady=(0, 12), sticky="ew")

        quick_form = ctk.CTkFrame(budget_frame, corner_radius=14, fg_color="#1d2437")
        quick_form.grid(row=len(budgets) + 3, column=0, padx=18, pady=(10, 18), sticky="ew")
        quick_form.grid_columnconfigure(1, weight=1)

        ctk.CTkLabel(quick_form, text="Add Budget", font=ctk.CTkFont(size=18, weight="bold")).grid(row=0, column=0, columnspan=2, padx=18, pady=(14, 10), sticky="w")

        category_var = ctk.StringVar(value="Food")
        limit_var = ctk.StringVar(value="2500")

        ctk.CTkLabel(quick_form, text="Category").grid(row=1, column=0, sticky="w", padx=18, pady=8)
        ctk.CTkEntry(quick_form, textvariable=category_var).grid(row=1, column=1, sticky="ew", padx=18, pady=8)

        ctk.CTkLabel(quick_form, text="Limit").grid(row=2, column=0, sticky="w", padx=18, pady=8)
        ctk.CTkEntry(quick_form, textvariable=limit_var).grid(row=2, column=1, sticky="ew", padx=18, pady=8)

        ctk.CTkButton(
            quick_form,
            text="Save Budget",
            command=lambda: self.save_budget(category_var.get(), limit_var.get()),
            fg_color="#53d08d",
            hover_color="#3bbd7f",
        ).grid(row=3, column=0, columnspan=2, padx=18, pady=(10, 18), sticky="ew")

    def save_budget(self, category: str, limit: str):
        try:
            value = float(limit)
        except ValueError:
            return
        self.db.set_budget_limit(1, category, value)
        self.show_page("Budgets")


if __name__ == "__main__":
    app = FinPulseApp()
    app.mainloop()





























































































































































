import sqlite3
import os
from datetime import datetime


class DatabaseManager:
    """SQLite-backed database manager for a personal finance dashboard."""

    def __init__(self, db_path: str = "finpulse.db"):
        self.db_path = db_path
        self._initialize_database()

    def _connect(self):
        return sqlite3.connect(self.db_path)

    def _initialize_database(self):
        conn = self._connect()
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS transactions (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                transaction_type TEXT NOT NULL CHECK(transaction_type IN ('Income', 'Expense')),
                category TEXT NOT NULL,
                amount REAL NOT NULL,
                transaction_date TEXT NOT NULL,
                notes TEXT DEFAULT ''
            )
            """
        )
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS budgets (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                category TEXT NOT NULL,
                monthly_limit REAL NOT NULL,
                UNIQUE(user_id, category)
            )
            """
        )
        conn.commit()
        conn.close()

        self._seed_default_budgets()

    def _seed_default_budgets(self):
        defaults = {
            "Housing": 6000.0,
            "Food": 3000.0,
            "Transport": 1500.0,
            "Utilities": 2000.0,
            "Entertainment": 1200.0,
            "Savings": 5000.0,
        }

        conn = self._connect()
        for category, limit in defaults.items():
            existing = conn.execute(
                "SELECT 1 FROM budgets WHERE user_id = ? AND category = ?",
                (1, category),
            ).fetchone()
            if not existing:
                conn.execute(
                    "INSERT INTO budgets (user_id, category, monthly_limit) VALUES (?, ?, ?)",
                    (1, category, limit),
                )
        conn.commit()
        conn.close()

    def add_transaction(
        self,
        user_id: int,
        transaction_type: str,
        category: str,
        amount: float,
        transaction_date: str,
        notes: str = "",
    ) -> int:
        """Insert a new transaction and return its id."""
        conn = self._connect()
        cursor = conn.execute(
            """
            INSERT INTO transactions (user_id, transaction_type, category, amount, transaction_date, notes)
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (user_id, transaction_type, category.strip(), float(amount), transaction_date, notes.strip()),
        )
        conn.commit()
        transaction_id = cursor.lastrowid
        conn.close()
        return transaction_id

    def fetch_user_expenses(self, user_id: int):
        """Return categories and total spend amounts for expenses."""
        conn = self._connect()
        rows = conn.execute(
            """
            SELECT category, SUM(amount) AS total
            FROM transactions
            WHERE user_id = ? AND transaction_type = 'Expense'
            GROUP BY category
            ORDER BY total DESC
            """,
            (user_id,),
        ).fetchall()
        conn.close()

        categories = [row[0] for row in rows]
        amounts = [float(row[1]) for row in rows]
        return categories, amounts

    def fetch_dashboard_summary(self, user_id: int):
        """Return total income, expenses, and current balance."""
        conn = self._connect()
        income = conn.execute(
            "SELECT COALESCE(SUM(amount), 0) FROM transactions WHERE user_id = ? AND transaction_type = 'Income'",
            (user_id,),
        ).fetchone()[0]
        expenses = conn.execute(
            "SELECT COALESCE(SUM(amount), 0) FROM transactions WHERE user_id = ? AND transaction_type = 'Expense'",
            (user_id,),
        ).fetchone()[0]
        conn.close()
        return {
            "income": float(income),
            "expenses": float(expenses),
            "balance": float(income - expenses),
        }

    def fetch_recent_transactions(self, user_id: int, limit: int = 5):
        conn = self._connect()
        rows = conn.execute(
            """
            SELECT category, amount, transaction_type AS type, transaction_date AS date, notes
            FROM transactions
            WHERE user_id = ?
            ORDER BY date(transaction_date) DESC, id DESC
            LIMIT ?
            """,
            (user_id, limit),
        ).fetchall()
        conn.close()
        return [
            {
                "date": row[3],
                "category": row[0],
                "type": row[2],
                "amount": float(row[1]),
                "notes": row[4],
            }
            for row in rows
        ]

    def get_spending_by_month(self, user_id: int, months: int = 6):
        """Return monthly expense totals over the last N months."""
        conn = self._connect()
        rows = conn.execute(
            """
            SELECT strftime('%Y-%m', transaction_date) AS month, SUM(amount) AS total
            FROM transactions
            WHERE user_id = ? AND transaction_type = 'Expense'
            GROUP BY strftime('%Y-%m', transaction_date)
            ORDER BY month DESC
            LIMIT ?
            """,
            (user_id, months),
        ).fetchall()
        conn.close()

        ordered = list(reversed(rows))
        labels = [row[0] for row in ordered]
        values = [float(row[1]) for row in ordered]
        return labels, values

    def fetch_budgets(self, user_id: int):
        conn = self._connect()
        rows = conn.execute(
            "SELECT category, monthly_limit FROM budgets WHERE user_id = ? ORDER BY category ASC",
            (user_id,),
        ).fetchall()
        conn.close()
        return [{"category": row[0], "limit": float(row[1])} for row in rows]

    def set_budget_limit(self, user_id: int, category: str, monthly_limit: float):
        conn = self._connect()
        conn.execute(
            """
            INSERT INTO budgets (user_id, category, monthly_limit)
            VALUES (?, ?, ?)
            ON CONFLICT(user_id, category) DO UPDATE SET monthly_limit = excluded.monthly_limit
            """,
            (user_id, category.strip(), float(monthly_limit)),
        )
        conn.commit()
        conn.close()

    def get_budget_usage(self, user_id: int, category: str):
        conn = self._connect()
        current_month = datetime.now().strftime("%Y-%m")
        row = conn.execute(
            """
            SELECT COALESCE(SUM(amount), 0)
            FROM transactions
            WHERE user_id = ?
              AND transaction_type = 'Expense'
              AND category = ?
              AND strftime('%Y-%m', transaction_date) = ?
            """,
            (user_id, category, current_month),
        ).fetchone()
        conn.close()
        return float(row[0]) if row else 0.0

    def get_transaction_count(self, user_id: int):
        conn = self._connect()
        row = conn.execute(
            "SELECT COUNT(*) FROM transactions WHERE user_id = ?",
            (user_id,),
        ).fetchone()
        conn.close()
        return int(row[0]) if row else 0

    def __repr__(self):
        return f"DatabaseManager(db_path={self.db_path})"

    def clear_demo_data(self):
        conn = self._connect()
        conn.execute("DELETE FROM transactions WHERE user_id = 1")
        conn.execute("DELETE FROM budgets WHERE user_id = 1")
        conn.commit()
        conn.close()
        self._seed_default_budgets()


if __name__ == "__main__":
    db = DatabaseManager()
    print(db)
    print(db.fetch_dashboard_summary(1))


















































































































































































































































































	
																																																																																																																																																																														