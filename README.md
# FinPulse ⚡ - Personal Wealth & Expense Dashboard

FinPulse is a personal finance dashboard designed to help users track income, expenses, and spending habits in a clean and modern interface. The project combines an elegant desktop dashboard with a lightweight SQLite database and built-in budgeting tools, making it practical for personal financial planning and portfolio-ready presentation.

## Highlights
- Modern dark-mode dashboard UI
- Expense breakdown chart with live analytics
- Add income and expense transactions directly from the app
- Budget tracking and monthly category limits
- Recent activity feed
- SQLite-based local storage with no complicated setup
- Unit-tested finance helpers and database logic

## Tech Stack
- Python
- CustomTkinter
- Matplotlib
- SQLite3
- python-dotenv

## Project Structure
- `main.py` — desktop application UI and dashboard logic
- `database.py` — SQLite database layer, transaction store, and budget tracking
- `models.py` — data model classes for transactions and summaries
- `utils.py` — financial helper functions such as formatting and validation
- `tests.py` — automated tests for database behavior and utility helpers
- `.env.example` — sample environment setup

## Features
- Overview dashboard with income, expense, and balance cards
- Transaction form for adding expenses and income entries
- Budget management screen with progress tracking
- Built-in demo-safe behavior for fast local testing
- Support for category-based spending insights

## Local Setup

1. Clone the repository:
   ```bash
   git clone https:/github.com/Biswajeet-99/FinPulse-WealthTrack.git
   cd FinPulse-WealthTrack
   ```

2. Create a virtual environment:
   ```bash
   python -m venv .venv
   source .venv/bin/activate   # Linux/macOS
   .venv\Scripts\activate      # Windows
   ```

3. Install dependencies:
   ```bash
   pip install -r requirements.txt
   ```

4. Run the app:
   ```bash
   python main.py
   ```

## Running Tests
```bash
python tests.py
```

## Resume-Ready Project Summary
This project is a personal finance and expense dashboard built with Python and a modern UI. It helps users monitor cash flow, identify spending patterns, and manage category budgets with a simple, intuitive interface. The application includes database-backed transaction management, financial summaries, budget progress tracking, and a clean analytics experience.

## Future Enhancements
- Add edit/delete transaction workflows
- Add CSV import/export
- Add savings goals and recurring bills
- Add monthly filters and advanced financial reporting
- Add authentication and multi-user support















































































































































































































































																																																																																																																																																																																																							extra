"""Reusable financial utility helpers."""


def format_currency(amount: float) -> str:
    """Formats a float value into a standard Indian Rupee string."""
    return f"₹{amount:,.2f}"


def calculate_percentage(part: float, whole: float) -> str:
    """Calculates percentage safely to avoid division by zero errors."""
    if whole == 0:
        return "0.0%"
    return f"{(part / whole) * 100:.1f}%"


def validate_transaction_amount(amount: float) -> bool:
    """Checks if a transaction amount is valid (greater than zero)."""
    return amount > 0


def normalize_amount(value: float | str) -> float:
    """Safely converts a value to a float."""
    try:
        return float(value)
    except (TypeError, ValueError):
        return 0.0


def get_month_label(date_text: str) -> str:
    """Short month label from YYYY-MM-DD or YYYY-MM format."""
    try:
        if len(date_text) >= 7:
            return date_text[:7]
        return date_text
    except (TypeError, ValueError):
        return "unknown"





















































































































