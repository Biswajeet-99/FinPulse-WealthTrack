import unittest

from database import DatabaseManager
from utils import (
    calculate_percentage,
    format_currency,
    get_month_label,
    normalize_amount,
    validate_transaction_amount,
)


class TestFinPulseUtils(unittest.TestCase):
    def test_format_currency(self):
        self.assertEqual(format_currency(1500.5), "₹1,500.50")
        self.assertEqual(format_currency(0), "₹0.00")

    def test_calculate_percentage(self):
        self.assertEqual(calculate_percentage(50, 100), "50.0%")
        self.assertEqual(calculate_percentage(50, 0), "0.0%")

    def test_validate_transaction(self):
        self.assertTrue(validate_transaction_amount(100.0))
        self.assertFalse(validate_transaction_amount(-50.0))
        self.assertFalse(validate_transaction_amount(0))

    def test_normalize_amount(self):
        self.assertEqual(normalize_amount("1250.75"), 1250.75)
        self.assertEqual(normalize_amount("not-a-number"), 0.0)

    def test_get_month_label(self):
        self.assertEqual(get_month_label("2026-10-29"), "2026-10")


class TestDatabaseManager(unittest.TestCase):
    def setUp(self):
        self.db = DatabaseManager(db_path=":memory:")

    def test_add_and_fetch_transactions(self):
        self.db.add_transaction(1, "Expense", "Food", 250.0, "2026-10-29", "Lunch")
        self.db.add_transaction(1, "Income", "Salary", 5000.0, "2026-10-01", "Monthly salary")

        categories, values = self.db.fetch_user_expenses(1)
        self.assertIn("Food", categories)
        self.assertEqual(values[0], 250.0)

        summary = self.db.fetch_dashboard_summary(1)
        self.assertEqual(summary["income"], 5000.0)
        self.assertEqual(summary["expenses"], 250.0)
        self.assertEqual(summary["balance"], 4750.0)

    def test_budget_limit_and_usage(self):
        self.db.set_budget_limit(1, "Food", 3000.0)
        self.db.add_transaction(1, "Expense", "Food", 700.0, "2026-10-14", "Groceries")
        self.assertEqual(self.db.get_budget_usage(1, "Food"), 700.0)
        budgets = self.db.fetch_budgets(1)
        self.assertTrue(any(b["category"] == "Food" for b in budgets))


if __name__ == "__main__":
    unittest.main()





































































































































































